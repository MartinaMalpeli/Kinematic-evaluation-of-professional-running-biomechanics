ta_dx_mvc = filtfilt(b,a,ta_dx_mvc);
gc_sx_mvc = filtfilt(b,a,gc_sx_mvc);
gc_dx_mvc = filtfilt(b,a,gc_dx_mvc);
rf_sx_mvc = filtfilt(b,a,rf_sx_mvc);
rf_dx_mvc = filtfilt(b,a,rf_dx_mvc);
bf_sx_mvc = filtfilt(b,a,bf_sx_mvc);
bf_dx_mvc = filtfilt(b,a,bf_dx_mvc);

% rettiffica
ta_sx_mvc = abs(ta_sx_mvc);
ta_dx_mvc = abs(ta_dx_mvc);
gc_sx_mvc = abs(gc_sx_mvc);
gc_dx_mvc = abs(gc_dx_mvc);
rf_sx_mvc = abs(rf_sx_mvc);
rf_dx_mvc = abs(rf_dx_mvc);
bf_sx_mvc = abs(bf_sx_mvc);
bf_dx_mvc = abs(bf_dx_mvc);

% envelope con filtro passa basso
butter_order = 4;
butter_low_pass = 6;
[b,a] = butter(butter_order, butter_low_pass/(freq_emg/2),'low');
ta_sx_mvc = filtfilt(b,a,ta_sx_mvc);
ta_dx_mvc = filtfilt(b,a,ta_dx_mvc);
gc_sx_mvc = filtfilt(b,a,gc_sx_mvc);
gc_dx_mvc = filtfilt(b,a,gc_dx_mvc);
rf_sx_mvc = filtfilt(b,a,rf_sx_mvc);
rf_dx_mvc = filtfilt(b,a,rf_dx_mvc);
bf_sx_mvc = filtfilt(b,a,bf_sx_mvc);
bf_dx_mvc = filtfilt(b,a,bf_dx_mvc);

ta_sx_mvc = movmean(ta_sx_mvc,500);
ta_dx_mvc = movmean(ta_dx_mvc,500);
gc_sx_mvc = movmean(gc_sx_mvc,500);
gc_dx_mvc = movmean(gc_dx_mvc,500);
rf_sx_mvc = movmean(rf_sx_mvc,500);
rf_dx_mvc = movmean(rf_dx_mvc,500);
bf_sx_mvc = movmean(bf_sx_mvc,500);
bf_dx_mvc = movmean(bf_dx_mvc,500);

max_ta_sx = max(ta_sx_mvc);
max_ta_dx = max(ta_dx_mvc);
